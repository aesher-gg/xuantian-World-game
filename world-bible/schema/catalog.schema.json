{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xuantian World Bible Import Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "summary",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "source": {
      "type": "object",
      "required": [
        "repository",
        "branch",
        "commitSha",
        "policy"
      ],
      "properties": {
        "repository": {
          "const": "aesher-gg/Xuantian-World"
        },
        "branch": {
          "type": "string"
        },
        "commitSha": {
          "type": "string",
          "minLength": 7
        },
        "policy": {
          "const": "read-only"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "indexedModuleCount",
        "importedModuleCount",
        "regionModules",
        "systemModules"
      ],
      "properties": {
        "indexedModuleCount": {
          "type": "integer",
          "minimum": 1
        },
        "importedModuleCount": {
          "type": "integer",
          "minimum": 1
        },
        "regionModules": {
          "type": "array"
        },
        "systemModules": {
          "type": "array"
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "title",
          "blobSha",
          "lineCount",
          "headings",
          "sections",
          "tables",
          "codeBlocks",
          "formulaBlocks",
          "references"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "blobSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "lineCount": {
            "type": "integer",
            "minimum": 1
          },
          "headings": {
            "type": "array"
          },
          "sections": {
            "type": "array"
          },
          "tables": {
            "type": "array"
          },
          "codeBlocks": {
            "type": "array"
          },
          "formulaBlocks": {
            "type": "array"
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
